---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lock Chip Rankings">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header */}
    <div class="page-header">
      <h1 class="page-title">Lock Chip Rankings</h1>
      <p class="page-subtitle">
        Swappable character chips on CX blades
      </p>
      {/* Material Filter */}
      <div class="flex gap-2 mt-4" id="material-filter">
        <button class="filter-btn active px-4 py-1.5 text-sm font-mono rounded-lg border border-stroke transition-all" data-filter="all">All</button>
        <button class="filter-btn px-4 py-1.5 text-sm font-mono rounded-lg border border-stroke transition-all" data-filter="metal">Metal</button>
        <button class="filter-btn px-4 py-1.5 text-sm font-mono rounded-lg border border-stroke transition-all" data-filter="plastic">Plastic</button>
      </div>
    </div>

    {/* Rankings Table */}
    <div class="card card-padding">
      <div class="overflow-x-auto">
        <table class="data-table" id="rankings-table">
          <thead>
            <tr>
              <th class="w-16">#</th>
              <th>Lock Chip</th>
              <th class="text-right">APEX</th>
              <th class="text-right">Uses</th>
              <th class="text-right">1st</th>
              <th class="text-right">2nd</th>
              <th class="text-right">3rd</th>
              <th class="text-right">1st %</th>
              <th class="text-right">Trend</th>
            </tr>
          </thead>
          <tbody id="rankings-body">
            {/* Loading skeletons */}
            {Array.from({ length: 10 }, () => (
              <tr>
                <td colspan="9">
                  <div class="skeleton h-12 rounded"></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Info Section */}
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-series-cx">#</span> About Lock Chips
        </h3>
        <p class="text-fg-muted text-sm">
          Lock chips are the character-themed component of CX blades. They can be swapped between
          different CX main blades to create custom combinations like Cerberus Blast or Emperor Brave.
        </p>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> CX Blade Format
        </h3>
        <div class="space-y-2 text-sm">
          <div class="text-fg-muted">
            CX blade structure:
          </div>
          <div class="font-mono text-fg">
            [Lock Chip] + [Main Blade]
          </div>
          <div class="text-fg-muted text-xs mt-2">
            Example: Pegasus + Blast = Pegasus Blast
          </div>
        </div>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Known Lock Chips
        </h3>
        <div class="flex flex-wrap gap-1 text-xs font-mono">
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Pegasus</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Cerberus</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Emperor</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Valkyrie</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Dran</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Hells</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Wizard</span>
          <span class="px-2 py-0.5 bg-series-cx/20 text-series-cx rounded">Phoenix</span>
        </div>
      </div>
    </div>

    {/* Empty State */}
    <div id="empty-state" class="hidden mt-8 card card-padding text-center py-12">
      <div class="text-6xl mb-4">&#x1F50D;</div>
      <h3 class="text-xl font-mono font-bold text-fg mb-2">No Lock Chip Data Found</h3>
      <p class="text-fg-muted">
        Lock chip data is extracted from CX blade combinations in tournament results.
        Check back as more CX blades are used in tournaments.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { initDB, getRankedLockChips, getBestCombosForLockChip, getLockChipMaterial, type Region } from '../lib/db';
  import { staggerFadeIn } from '../lib/animations';

  let currentFilter: 'all' | 'metal' | 'plastic' = 'all';
  let allLockChipData: Awaited<ReturnType<typeof getRankedLockChips>> = [];

  function getSelectedRegion(): Region {
    if (typeof localStorage !== 'undefined') {
      return (localStorage.getItem('beyblade-region') as Region) || 'ALL';
    }
    return 'ALL';
  }

  async function loadRankings() {
    try {
      await initDB();
      const region = getSelectedRegion();
      allLockChipData = await getRankedLockChips(25, 1, region, (window as any).getSelectedTimeWindow?.() || { mode: 'all' });

      if (allLockChipData.length === 0) {
        // Show empty state
        document.getElementById('rankings-table')?.closest('.card')?.classList.add('hidden');
        document.getElementById('empty-state')?.classList.remove('hidden');
        return;
      }

      applyFilter();
    } catch (error) {
      console.error('Failed to load rankings:', error);
      const tbody = document.getElementById('rankings-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center text-negative py-8">
              Failed to load lock chip rankings. Please refresh the page.
            </td>
          </tr>
        `;
      }
    }
  }

  function renderTable(lockChips: Awaited<ReturnType<typeof getRankedLockChips>>) {
    const tbody = document.getElementById('rankings-body');
    if (!tbody) return;

    tbody.innerHTML = lockChips.map((chip, index) => {
      return `
      <tr class="ranking-row cursor-pointer hover:bg-panel" data-lockchip="${chip.name}">
        <td class="font-mono text-center">
          <span class="rank-number text-lg">${index + 1}</span>
        </td>
        <td>
          <span class="px-3 py-1 text-sm font-mono font-bold rounded bg-series-cx/20 text-series-cx border border-series-cx/40">
            ${chip.name}
          </span>
          ${getLockChipMaterial(chip.name) === 'Metal'
            ? '<span class="ml-2 px-2 py-0.5 text-xs font-mono rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">Metal</span>'
            : '<span class="ml-2 px-2 py-0.5 text-xs font-mono rounded bg-fg-muted/20 text-fg-muted border border-fg-muted/30">Plastic</span>'
          }
        </td>
        <td class="text-right font-mono text-accent">${chip.raw_score.toFixed(1)}</td>
        <td class="text-right font-mono">${chip.uses}</td>
        <td class="text-right font-mono text-tier-ss">${chip.first}</td>
        <td class="text-right font-mono text-fg-muted">${chip.second}</td>
        <td class="text-right font-mono text-tier-a">${chip.third}</td>
        <td class="text-right font-mono">${chip.uses > 0 ? ((chip.first / chip.uses) * 100).toFixed(1) : '0.0'}%</td>
        <td class="text-right">${getTrendHtml(chip.trend)}</td>
      </tr>
    `}).join('');

    // Add click handlers to rows
    tbody.querySelectorAll('.ranking-row').forEach(row => {
      row.addEventListener('click', () => {
        const lockChipName = row.getAttribute('data-lockchip');
        if (lockChipName) showLockChipDetail(lockChipName, row as HTMLTableRowElement);
      });
    });

    staggerFadeIn(tbody.querySelectorAll('tr'), { delay: 30 });
  }

  function getTrendHtml(trend: number): string {
    if (trend > 0.1) {
      return `<span class="text-positive text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        +${(trend * 100).toFixed(0)}%
      </span>`;
    } else if (trend < -0.1) {
      return `<span class="text-negative text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        ${(trend * 100).toFixed(0)}%
      </span>`;
    }
    return '<span class="text-fg-muted text-sm">--</span>';
  }

  // Track expanded detail row state
  let expandedLockChipRow: HTMLTableRowElement | null = null;
  let lockChipDetailRow: HTMLTableRowElement | null = null;

  function collapseDetail() {
    if (expandedLockChipRow) {
      expandedLockChipRow.classList.remove('expanded');
      expandedLockChipRow = null;
    }
    if (lockChipDetailRow) {
      const oldRow = lockChipDetailRow;
      lockChipDetailRow = null;
      const content = oldRow.querySelector('.detail-content');
      if (content) {
        content.classList.remove('open');
        setTimeout(() => oldRow.remove(), 300);
      } else {
        oldRow.remove();
      }
    }
  }

  async function showLockChipDetail(name: string, clickedRow?: HTMLTableRowElement) {
    // If clicking the same row, toggle off
    if (clickedRow && expandedLockChipRow === clickedRow) {
      collapseDetail();
      return;
    }

    // Collapse any existing detail
    collapseDetail();

    if (!clickedRow) return;

    // Mark this row as expanded
    expandedLockChipRow = clickedRow;
    clickedRow.classList.add('expanded');

    // Create the detail row with loading state
    lockChipDetailRow = document.createElement('tr');
    lockChipDetailRow.className = 'detail-row';
    lockChipDetailRow.innerHTML = `
      <td colspan="9">
        <div class="detail-content">
          <div class="detail-inner">
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-lg font-mono font-bold text-fg">${name}</h3>
              <span class="text-fg-muted text-sm">Best combinations</span>
            </div>
            <div id="lockchip-combos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <div class="col-span-full text-center py-4">
                <div class="w-6 h-6 border-2 border-stroke border-t-accent rounded-full animate-spin mx-auto"></div>
              </div>
            </div>
          </div>
        </div>
      </td>
    `;

    // Insert after the clicked row
    clickedRow.after(lockChipDetailRow);

    // Trigger open animation
    requestAnimationFrame(() => {
      const content = lockChipDetailRow?.querySelector('.detail-content');
      if (content) content.classList.add('open');
    });

    try {
      const region = getSelectedRegion();
      const combos = await getBestCombosForLockChip(name, 9, region);
      const combosGrid = lockChipDetailRow?.querySelector('#lockchip-combos-grid');
      if (!combosGrid) return;

      if (combos.length === 0) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-fg-muted py-4">No combo data available</div>';
        return;
      }

      combosGrid.innerHTML = combos.map((combo, i) => `
        <div class="card card-padding">
          <div class="flex items-start gap-3">
            <span class="rank-number text-lg">${i + 1}</span>
            <div class="flex-grow">
              <div class="font-mono font-bold text-fg text-sm">${combo.combo}</div>
              <div class="flex items-center gap-2 mt-1 text-xs">
                ${combo.assist ? `<span class="text-series-cx">${combo.assist}</span>` : ''}
                <span class="text-series-ux">${combo.ratchet}</span>
                <span class="text-series-bx">${combo.bit}</span>
              </div>
              <div class="flex items-center gap-3 mt-1 text-xs">
                <span class="text-accent font-mono">${combo.raw_score.toFixed(1)}</span>
                <span class="text-fg-muted">${combo.uses} uses</span>
                <span class="text-tier-ss">${combo.first} wins</span>
              </div>
            </div>
          </div>
        </div>
      `).join('');

      staggerFadeIn(combosGrid.children, { delay: 50 });
    } catch (error) {
      console.error('Failed to load lock chip combos:', error);
      const combosGrid = lockChipDetailRow?.querySelector('#lockchip-combos-grid');
      if (combosGrid) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-negative py-4">Failed to load combos</div>';
      }
    }
  }

  function applyFilter() {
    let filtered = allLockChipData;
    if (currentFilter === 'metal') {
      filtered = allLockChipData.filter(c => getLockChipMaterial(c.name) === 'Metal');
    } else if (currentFilter === 'plastic') {
      filtered = allLockChipData.filter(c => getLockChipMaterial(c.name) === 'Plastic');
    }
    renderTable(filtered);
  }

  function initFilterButtons() {
    document.querySelectorAll('#material-filter .filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = (btn.getAttribute('data-filter') as typeof currentFilter) || 'all';
        document.querySelectorAll('#material-filter .filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        collapseDetail();
        applyFilter();
      });
    });
  }

  const lockChipInit = () => { initFilterButtons(); loadRankings(); };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', lockChipInit);
  } else {
    lockChipInit();
  }

  // Reload when region changes
  window.addEventListener('regionchange', () => {
    collapseDetail();
    loadRankings();
  });
  window.addEventListener('timechange', () => {
    collapseDetail();
    loadRankings();
  });
</script>
