---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Over Blade Rankings">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header */}
    <div class="page-header">
      <h1 class="page-title">Over Blade Rankings</h1>
      <p class="page-subtitle">
        CX-exclusive armor plates
      </p>
    </div>

    {/* Rankings Table */}
    <div class="card card-padding">
      <div class="overflow-x-auto">
        <table class="data-table" id="rankings-table">
          <thead>
            <tr>
              <th class="w-16">#</th>
              <th>Over Blade</th>
              <th class="text-right">Score</th>
              <th class="text-right">Uses</th>
              <th class="text-right">1st</th>
              <th class="text-right">2nd</th>
              <th class="text-right">3rd</th>
              <th class="text-right">1st %</th>
              <th class="text-right">Trend</th>
            </tr>
          </thead>
          <tbody id="rankings-body">
            {/* Loading skeletons */}
            {Array.from({ length: 5 }, () => (
              <tr>
                <td colspan="9">
                  <div class="skeleton h-12 rounded"></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Info Section */}
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-series-cx">#</span> About Over Blades
        </h3>
        <p class="text-fg-muted text-sm">
          Over blades are CX-exclusive armor plates that mount on top of the main blade.
          They add weight, change contact points, and alter the attack/defense profile of the combo.
        </p>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Available Over Blades
        </h3>
        <div class="space-y-2 text-sm">
          <div class="text-fg-muted">
            Currently released:
          </div>
          <div class="font-mono text-fg space-y-1">
            <div>Break</div>
            <div>Flow</div>
            <div>Guard</div>
          </div>
        </div>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Scoring System
        </h3>
        <p class="text-fg-muted text-sm">
          Score is calculated using recency-weighted placement points: 1st = 3pts, 2nd = 2pts, 3rd = 1pt.
          Recent tournaments count more than older ones.
        </p>
      </div>
    </div>

    {/* Empty State */}
    <div id="empty-state" class="hidden mt-8 card card-padding text-center py-12">
      <h3 class="text-xl font-mono font-bold text-fg mb-2">No Over Blade Data Yet</h3>
      <p class="text-fg-muted">
        Over blades are a new CX component and haven't appeared in enough tournament results yet.
        Check back as more CX combos with over blades are used competitively.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { initDB, getRankedOverBlades, getBestCombosForOverBlade, type Region } from '../lib/db';
  import { staggerFadeIn } from '../lib/animations';

  function getSelectedRegion(): Region {
    if (typeof localStorage !== 'undefined') {
      return (localStorage.getItem('beyblade-region') as Region) || 'ALL';
    }
    return 'ALL';
  }

  async function loadRankings() {
    try {
      await initDB();
      const region = getSelectedRegion();
      const overBlades = await getRankedOverBlades(25, 1, region);

      if (overBlades.length === 0) {
        // Show empty state
        document.getElementById('rankings-table')?.closest('.card')?.classList.add('hidden');
        document.getElementById('empty-state')?.classList.remove('hidden');
        return;
      }

      // Make sure table is visible and empty state hidden
      document.getElementById('rankings-table')?.closest('.card')?.classList.remove('hidden');
      document.getElementById('empty-state')?.classList.add('hidden');

      renderTable(overBlades);
    } catch (error) {
      console.error('Failed to load rankings:', error);
      const tbody = document.getElementById('rankings-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center text-negative py-8">
              Failed to load over blade rankings. Please refresh the page.
            </td>
          </tr>
        `;
      }
    }
  }

  function renderTable(overBlades: Awaited<ReturnType<typeof getRankedOverBlades>>) {
    const tbody = document.getElementById('rankings-body');
    if (!tbody) return;

    tbody.innerHTML = overBlades.map((ob, index) => {
      return `
      <tr class="ranking-row cursor-pointer hover:bg-panel" data-overblade="${ob.name}">
        <td class="font-mono text-center">
          <span class="rank-number text-lg">${index + 1}</span>
        </td>
        <td>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-sm font-mono font-bold rounded bg-series-cx/20 text-series-cx border border-series-cx/40">
              ${ob.name}
            </span>
            <span class="text-xs font-mono text-fg-muted">CX</span>
          </div>
        </td>
        <td class="text-right font-mono text-accent">${ob.raw_score.toFixed(1)}</td>
        <td class="text-right font-mono">${ob.uses}</td>
        <td class="text-right font-mono text-tier-ss">${ob.first}</td>
        <td class="text-right font-mono text-fg-muted">${ob.second}</td>
        <td class="text-right font-mono text-tier-a">${ob.third}</td>
        <td class="text-right font-mono">${ob.uses > 0 ? ((ob.first / ob.uses) * 100).toFixed(1) : '0.0'}%</td>
        <td class="text-right">${getTrendHtml(ob.trend)}</td>
      </tr>
    `}).join('');

    // Add click handlers to rows
    tbody.querySelectorAll('.ranking-row').forEach(row => {
      row.addEventListener('click', () => {
        const overBladeName = row.getAttribute('data-overblade');
        if (overBladeName) showOverBladeDetail(overBladeName, row as HTMLTableRowElement);
      });
    });

    staggerFadeIn(tbody.querySelectorAll('tr'), { delay: 30 });
  }

  // Track expanded detail row state
  let expandedOverBladeRow: HTMLTableRowElement | null = null;
  let overBladeDetailRow: HTMLTableRowElement | null = null;

  function collapseOverBladeDetail() {
    if (expandedOverBladeRow) {
      expandedOverBladeRow.classList.remove('expanded');
      expandedOverBladeRow = null;
    }
    if (overBladeDetailRow) {
      const oldRow = overBladeDetailRow;
      overBladeDetailRow = null;
      const content = oldRow.querySelector('.detail-content');
      if (content) {
        content.classList.remove('open');
        setTimeout(() => oldRow.remove(), 300);
      } else {
        oldRow.remove();
      }
    }
  }

  async function showOverBladeDetail(name: string, clickedRow?: HTMLTableRowElement) {
    // If clicking the same row, toggle off
    if (clickedRow && expandedOverBladeRow === clickedRow) {
      collapseOverBladeDetail();
      return;
    }

    // Collapse any existing detail
    collapseOverBladeDetail();

    if (!clickedRow) return;

    // Mark this row as expanded
    expandedOverBladeRow = clickedRow;
    clickedRow.classList.add('expanded');

    // Create the detail row with loading state
    overBladeDetailRow = document.createElement('tr');
    overBladeDetailRow.className = 'detail-row';
    overBladeDetailRow.innerHTML = `
      <td colspan="9">
        <div class="detail-content">
          <div class="detail-inner">
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-lg font-mono font-bold text-fg">${name}</h3>
              <span class="text-fg-muted text-sm">Best combinations</span>
            </div>
            <div id="overblade-combos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <div class="col-span-full text-center py-4">
                <div class="w-6 h-6 border-2 border-stroke border-t-accent rounded-full animate-spin mx-auto"></div>
              </div>
            </div>
          </div>
        </div>
      </td>
    `;

    // Insert after the clicked row
    clickedRow.after(overBladeDetailRow);

    // Trigger open animation
    requestAnimationFrame(() => {
      const content = overBladeDetailRow?.querySelector('.detail-content');
      if (content) content.classList.add('open');
    });

    try {
      const region = getSelectedRegion();
      const combos = await getBestCombosForOverBlade(name, 9, region);
      const combosGrid = overBladeDetailRow?.querySelector('#overblade-combos-grid');
      if (!combosGrid) return;

      if (combos.length === 0) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-fg-muted py-4">No combo data available</div>';
        return;
      }

      combosGrid.innerHTML = combos.map((combo, i) => `
        <div class="card card-padding">
          <div class="flex items-start gap-3">
            <span class="rank-number text-lg">${i + 1}</span>
            <div class="flex-grow">
              <div class="font-mono font-bold text-fg text-sm">${combo.combo}</div>
              <div class="flex items-center gap-2 mt-1 text-xs">
                <span class="text-series-ux">${combo.ratchet}</span>
                <span class="text-series-bx">${combo.bit}</span>
              </div>
              <div class="flex items-center gap-3 mt-1 text-xs">
                <span class="text-accent font-mono">${combo.raw_score.toFixed(1)}</span>
                <span class="text-fg-muted">${combo.uses} uses</span>
                <span class="text-tier-ss">${combo.first} wins</span>
              </div>
            </div>
          </div>
        </div>
      `).join('');

      staggerFadeIn(combosGrid.children, { delay: 50 });
    } catch (error) {
      console.error('Failed to load over blade combos:', error);
      const combosGrid = overBladeDetailRow?.querySelector('#overblade-combos-grid');
      if (combosGrid) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-negative py-4">Failed to load combos</div>';
      }
    }
  }

  function getTrendHtml(trend: number): string {
    if (trend > 0.1) {
      return `<span class="text-positive text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        +${(trend * 100).toFixed(0)}%
      </span>`;
    } else if (trend < -0.1) {
      return `<span class="text-negative text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        ${(trend * 100).toFixed(0)}%
      </span>`;
    }
    return '<span class="text-fg-muted text-sm">--</span>';
  }

  document.addEventListener('DOMContentLoaded', loadRankings);

  // Reload when region changes
  window.addEventListener('regionchange', () => {
    collapseOverBladeDetail();
    loadRankings();
  });
</script>
