---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Over Blade Rankings">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header */}
    <div class="mb-8">
      <h1 class="text-3xl font-mono font-bold text-fg mb-2">
        <span class="text-series-cx">#</span> Over Blade Rankings
      </h1>
      <p class="text-fg-secondary">
        Over blades ranked by weighted tournament performance. These are CX-exclusive armor plates that mount over the main blade.
      </p>
    </div>

    {/* Rankings Table */}
    <div class="card card-padding">
      <div class="overflow-x-auto">
        <table class="data-table" id="rankings-table">
          <thead>
            <tr>
              <th class="w-16">#</th>
              <th>Over Blade</th>
              <th class="text-right">Score</th>
              <th class="text-right">Uses</th>
              <th class="text-right">1st</th>
              <th class="text-right">2nd</th>
              <th class="text-right">3rd</th>
              <th class="text-right">1st %</th>
              <th class="text-right">Trend</th>
            </tr>
          </thead>
          <tbody id="rankings-body">
            {/* Loading skeletons */}
            {Array.from({ length: 5 }, () => (
              <tr>
                <td colspan="9">
                  <div class="skeleton h-12 rounded"></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Info Section */}
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-series-cx">#</span> About Over Blades
        </h3>
        <p class="text-fg-muted text-sm">
          Over blades are CX-exclusive armor plates that mount on top of the main blade.
          They add weight, change contact points, and alter the attack/defense profile of the combo.
        </p>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Available Over Blades
        </h3>
        <div class="space-y-2 text-sm">
          <div class="text-fg-muted">
            Currently released:
          </div>
          <div class="font-mono text-fg space-y-1">
            <div>Break</div>
            <div>Flow</div>
            <div>Guard</div>
          </div>
        </div>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Scoring System
        </h3>
        <p class="text-fg-muted text-sm">
          Score is calculated using recency-weighted placement points: 1st = 3pts, 2nd = 2pts, 3rd = 1pt.
          Recent tournaments count more than older ones.
        </p>
      </div>
    </div>

    {/* Empty State */}
    <div id="empty-state" class="hidden mt-8 card card-padding text-center py-12">
      <h3 class="text-xl font-mono font-bold text-fg mb-2">No Over Blade Data Yet</h3>
      <p class="text-fg-muted">
        Over blades are a new CX component and haven't appeared in enough tournament results yet.
        Check back as more CX combos with over blades are used competitively.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { initDB, getRankedOverBlades, type Region } from '../lib/db';
  import { staggerFadeIn } from '../lib/animations';

  function getSelectedRegion(): Region {
    if (typeof localStorage !== 'undefined') {
      return (localStorage.getItem('beyblade-region') as Region) || 'ALL';
    }
    return 'ALL';
  }

  async function loadRankings() {
    try {
      await initDB();
      const region = getSelectedRegion();
      const overBlades = await getRankedOverBlades(25, 1, region);

      if (overBlades.length === 0) {
        // Show empty state
        document.getElementById('rankings-table')?.closest('.card')?.classList.add('hidden');
        document.getElementById('empty-state')?.classList.remove('hidden');
        return;
      }

      // Make sure table is visible and empty state hidden
      document.getElementById('rankings-table')?.closest('.card')?.classList.remove('hidden');
      document.getElementById('empty-state')?.classList.add('hidden');

      renderTable(overBlades);
    } catch (error) {
      console.error('Failed to load rankings:', error);
      const tbody = document.getElementById('rankings-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center text-negative py-8">
              Failed to load over blade rankings. Please refresh the page.
            </td>
          </tr>
        `;
      }
    }
  }

  function renderTable(overBlades: Awaited<ReturnType<typeof getRankedOverBlades>>) {
    const tbody = document.getElementById('rankings-body');
    if (!tbody) return;

    tbody.innerHTML = overBlades.map((ob, index) => {
      return `
      <tr class="ranking-row">
        <td class="font-mono text-center">
          <span class="rank-number text-lg">${index + 1}</span>
        </td>
        <td>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-sm font-mono font-bold rounded bg-series-cx/20 text-series-cx border border-series-cx/40">
              ${ob.name}
            </span>
            <span class="text-xs font-mono text-fg-muted">CX</span>
          </div>
        </td>
        <td class="text-right font-mono text-accent">${ob.raw_score.toFixed(1)}</td>
        <td class="text-right font-mono">${ob.uses}</td>
        <td class="text-right font-mono text-tier-ss">${ob.first}</td>
        <td class="text-right font-mono text-fg-muted">${ob.second}</td>
        <td class="text-right font-mono text-tier-a">${ob.third}</td>
        <td class="text-right font-mono">${ob.uses > 0 ? ((ob.first / ob.uses) * 100).toFixed(1) : '0.0'}%</td>
        <td class="text-right">${getTrendHtml(ob.trend)}</td>
      </tr>
    `}).join('');

    staggerFadeIn(tbody.querySelectorAll('tr'), { delay: 30 });
  }

  function getTrendHtml(trend: number): string {
    if (trend > 0.1) {
      return `<span class="text-positive text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        +${(trend * 100).toFixed(0)}%
      </span>`;
    } else if (trend < -0.1) {
      return `<span class="text-negative text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        ${(trend * 100).toFixed(0)}%
      </span>`;
    }
    return '<span class="text-fg-muted text-sm">--</span>';
  }

  document.addEventListener('DOMContentLoaded', loadRankings);

  // Reload when region changes
  window.addEventListener('regionchange', () => {
    loadRankings();
  });
</script>
