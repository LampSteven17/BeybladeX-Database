---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Combo Rankings">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header */}
    <div class="mb-8">
      <h1 class="text-3xl font-mono font-bold text-fg mb-2">
        <span class="text-series-ux">#</span> Combo Rankings
      </h1>
      <p class="text-fg-secondary">
        Full blade + ratchet + bit combinations ranked by weighted tournament performance.
      </p>
    </div>

    {/* Search Bar */}
    <div class="mb-4">
      <div class="relative">
        <input
          type="text"
          id="search-input"
          placeholder="Search combos (blade, ratchet, or bit)..."
          class="input w-full md:w-96 pl-10"
        />
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-fg-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    {/* Tier Filter */}
    <div class="mb-6 flex flex-wrap gap-3 items-center">
      <span class="text-fg-muted text-sm">Filter by Tier:</span>
      <div class="flex flex-wrap gap-2">
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 bg-accent/10 text-accent border-accent/30" data-tier="all">All</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-ss border-tier-ss/30 hover:bg-tier-ss/10" data-tier="SS">SS</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-s border-tier-s/30 hover:bg-tier-s/10" data-tier="S">S</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-a border-tier-a/30 hover:bg-tier-a/10" data-tier="A">A</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-b border-tier-b/30 hover:bg-tier-b/10" data-tier="B">B</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-c border-tier-c/30 hover:bg-tier-c/10" data-tier="C">C</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-d border-tier-d/30 hover:bg-tier-d/10" data-tier="D">D</button>
        <button class="tier-filter px-2 py-1 text-xs font-mono rounded border transition-all duration-200 text-tier-f border-tier-f/30 hover:bg-tier-f/10" data-tier="F">F</button>
      </div>
      <span class="text-fg-muted text-sm ml-4">|</span>
      <button
        id="unique-blades-toggle"
        class="px-3 py-1 text-xs font-mono rounded border transition-all duration-200 text-fg-muted border-fg-muted/30 hover:bg-fg-muted/10"
      >
        Unique Blades Only
      </button>
    </div>

    {/* Combo Rankings Table */}
    <div class="card card-padding">
      <div class="overflow-x-auto">
        <table class="data-table" id="rankings-table">
          <thead>
            <tr>
              <th class="w-16">#</th>
              <th class="w-20">Tier</th>
              <th>Blade</th>
              <th>Assist</th>
              <th>Ratchet</th>
              <th>Bit</th>
              <th>Series</th>
              <th class="text-right">Score</th>
              <th class="text-right">Uses</th>
              <th class="text-right">1st</th>
              <th class="text-right">2nd</th>
              <th class="text-right">3rd</th>
              <th class="text-right">Trend</th>
            </tr>
          </thead>
          <tbody id="rankings-body">
            {/* Loading skeletons */}
            {Array.from({ length: 20 }, (_, i) => (
              <tr>
                <td colspan="13">
                  <div class="skeleton h-12 rounded"></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Load More Button */}
    <div class="mt-6 text-center">
      <button
        id="load-more-btn"
        class="btn-primary hidden"
      >
        Load More
      </button>
    </div>
  </div>
</Layout>

<script>
  import { initDB, getRankedCombos, getComboRadarStats, getMetaAverageRadarStats, BLADE_SERIES, type ComboStats, type ComboRadarStats, type Region } from '../lib/db';
  import { staggerFadeIn } from '../lib/animations';
  import { Chart, RadarController, RadialLinearScale, PointElement, LineElement, Filler, Tooltip } from 'chart.js';

  // Register Chart.js components for radar charts
  Chart.register(RadarController, RadialLinearScale, PointElement, LineElement, Filler, Tooltip);

  function getBladeBaseName(blade: string): string {
    const parts = blade.split(' ');
    if (parts.length > 1) {
      const lastPart = parts[parts.length - 1];
      if (BLADE_SERIES[lastPart]) return lastPart;
      if (BLADE_SERIES[parts[0]]) return parts[0];
    }
    return blade;
  }

  function getBladeSeries(blade: string): 'BX' | 'UX' | 'CX' | null {
    const baseName = getBladeBaseName(blade);
    return BLADE_SERIES[baseName] || null;
  }

  let allCombos: ComboStats[] = [];
  let filteredCombos: ComboStats[] = [];
  let displayedCount = 50;
  let currentTier: string = 'all';
  let searchQuery: string = '';
  let uniqueBladesOnly: boolean = false;
  const LOAD_INCREMENT = 50;

  // Radar chart state
  let expandedRow: HTMLTableRowElement | null = null;
  let detailRow: HTMLTableRowElement | null = null;
  let activeChart: Chart | null = null;
  let metaAverage: ComboRadarStats | null = null;

  function getSelectedRegion(): Region {
    if (typeof localStorage !== 'undefined') {
      return (localStorage.getItem('beyblade-region') as Region) || 'ALL';
    }
    return 'ALL';
  }

  let allCombosWithRare: ComboStats[] = [];

  async function loadRankings() {
    try {
      await initDB();
      const region = getSelectedRegion();
      allCombos = await getRankedCombos(500, 2, region);
      allCombosWithRare = await getRankedCombos(2000, 1, region);
      filteredCombos = allCombos;

      // Pre-fetch meta average for radar ghost overlay
      metaAverage = await getMetaAverageRadarStats();

      renderTable(filteredCombos.slice(0, displayedCount));
      updateLoadMoreButton();
      setupTierFilters();
      setupSearch();
    } catch (error) {
      console.error('Failed to load rankings:', error);
      const tbody = document.getElementById('rankings-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="13" class="text-center text-negative py-8">
              Failed to load combo rankings. Please refresh the page.
            </td>
          </tr>
        `;
      }
    }
  }

  function updateLoadMoreButton() {
    const btn = document.getElementById('load-more-btn');
    if (btn) {
      if (displayedCount < filteredCombos.length) {
        btn.classList.remove('hidden');
        btn.textContent = `Load More (${filteredCombos.length - displayedCount} remaining)`;
      } else {
        btn.classList.add('hidden');
      }
    }
  }

  function loadMore() {
    displayedCount += LOAD_INCREMENT;
    renderTable(filteredCombos.slice(0, displayedCount));
    updateLoadMoreButton();
  }

  function setupTierFilters() {
    document.querySelectorAll('.tier-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        const tier = btn.getAttribute('data-tier') || 'all';
        currentTier = tier;
        updateTierStyles(tier);
        applyTierFilter();
      });
    });
  }

  function updateTierStyles(activeTier: string) {
    document.querySelectorAll('.tier-filter').forEach(btn => {
      const tier = btn.getAttribute('data-tier');
      btn.classList.remove('bg-accent/10', 'bg-tier-ss/10', 'bg-tier-s/10', 'bg-tier-a/10', 'bg-tier-b/10', 'bg-tier-c/10', 'bg-tier-d/10', 'bg-tier-f/10');
      if (tier === activeTier) {
        if (tier === 'all') btn.classList.add('bg-accent/10');
        else if (tier === 'SS') btn.classList.add('bg-tier-ss/10');
        else if (tier === 'S') btn.classList.add('bg-tier-s/10');
        else if (tier === 'A') btn.classList.add('bg-tier-a/10');
        else if (tier === 'B') btn.classList.add('bg-tier-b/10');
        else if (tier === 'C') btn.classList.add('bg-tier-c/10');
        else if (tier === 'D') btn.classList.add('bg-tier-d/10');
        else if (tier === 'F') btn.classList.add('bg-tier-f/10');
      }
    });
  }

  function applyFilters() {
    collapseDetail();
    let filtered = searchQuery ? allCombosWithRare : allCombos;

    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      filtered = filtered.filter(c =>
        c.blade.toLowerCase().includes(query) ||
        c.ratchet.toLowerCase().includes(query) ||
        c.bit.toLowerCase().includes(query) ||
        c.combo.toLowerCase().includes(query)
      );
    }

    if (currentTier !== 'all') {
      filtered = filtered.filter(c => c.tier === currentTier);
    }

    if (uniqueBladesOnly) {
      const seenBlades = new Set<string>();
      filtered = filtered.filter(c => {
        if (seenBlades.has(c.blade)) return false;
        seenBlades.add(c.blade);
        return true;
      });
    }

    filteredCombos = filtered;
    displayedCount = 50;
    renderTable(filteredCombos.slice(0, displayedCount));
    updateLoadMoreButton();
  }

  function applyTierFilter() {
    applyFilters();
  }

  function setupSearch() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        applyFilters();
      });
    }
  }

  function getTier(combo: ComboStats): 'SS' | 'S' | 'A' | 'B' | 'C' | 'D' | 'F' {
    return combo.tier || 'C';
  }

  // Collapse any open detail row
  function collapseDetail() {
    if (activeChart) {
      activeChart.destroy();
      activeChart = null;
    }
    if (expandedRow) {
      expandedRow.classList.remove('expanded');
      expandedRow = null;
    }
    if (detailRow) {
      const oldRow = detailRow;
      detailRow = null;
      const content = oldRow.querySelector('.detail-content');
      if (content) {
        content.classList.remove('open');
        setTimeout(() => oldRow.remove(), 300);
      } else {
        oldRow.remove();
      }
    }
  }

  // Build stat bar HTML for a single stat
  function statBarHtml(label: string, value: number, rawValue: string, color: string): string {
    return `
      <div class="radar-stat-row">
        <span class="radar-stat-label">${label}</span>
        <div class="radar-stat-bar">
          <div class="radar-stat-fill" style="width: ${value}%; background: ${color};"></div>
        </div>
        <span class="radar-stat-value">${rawValue}</span>
      </div>
    `;
  }

  // Toggle combo detail with radar chart
  async function toggleComboDetail(row: HTMLTableRowElement) {
    const blade = row.dataset.blade || '';
    const ratchet = row.dataset.ratchet || '';
    const bit = row.dataset.bit || '';
    const assist = row.dataset.assist || '';

    // If clicking the same row, just collapse
    if (expandedRow === row) {
      collapseDetail();
      return;
    }

    // Collapse any existing detail first
    collapseDetail();

    // Mark this row as expanded
    expandedRow = row;
    row.classList.add('expanded');

    // Create the detail row
    detailRow = document.createElement('tr');
    detailRow.className = 'detail-row';
    detailRow.innerHTML = `
      <td colspan="13">
        <div class="detail-content">
          <div class="detail-inner">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="w-full md:w-64 flex-shrink-0 flex items-center justify-center">
                <canvas id="radar-chart" width="240" height="240"></canvas>
              </div>
              <div class="flex-1 min-w-0" id="stat-bars">
                <div class="text-xs text-fg-muted mb-3 font-mono uppercase tracking-wider">Official Stats</div>
                <div class="text-fg-muted text-sm py-4">Loading stats...</div>
              </div>
            </div>
          </div>
        </div>
      </td>
    `;

    // Insert after the clicked row
    row.after(detailRow);

    // Trigger animation
    requestAnimationFrame(() => {
      const content = detailRow!.querySelector('.detail-content');
      if (content) content.classList.add('open');
    });

    // Fetch stats
    const stats = await getComboRadarStats(blade, ratchet, bit, assist || null);
    const statBars = detailRow.querySelector('#stat-bars');

    if (!stats) {
      if (statBars) {
        statBars.innerHTML = `
          <div class="text-xs text-fg-muted mb-3 font-mono uppercase tracking-wider">Official Stats</div>
          <div class="text-fg-muted text-sm py-2">Stats unavailable for this combo's parts.</div>
        `;
      }
      return;
    }

    // Render stat bars
    if (statBars) {
      const accentColor = '#f97316';
      statBars.innerHTML = `
        <div class="text-xs text-fg-muted mb-3 font-mono uppercase tracking-wider">Official Stats</div>
        ${statBarHtml('Attack', stats.attack, String(stats.raw.attack), accentColor)}
        ${statBarHtml('Defense', stats.defense, String(stats.raw.defense), '#3b82f6')}
        ${statBarHtml('Stamina', stats.stamina, String(stats.raw.stamina), '#22c55e')}
        ${statBarHtml('Burst Res', stats.burstResistance, String(stats.raw.burstResistance), '#a855f7')}
        ${statBarHtml('Weight', stats.weight, stats.raw.weight + 'g', '#6b7280')}
      `;
    }

    // Render radar chart
    const canvas = detailRow.querySelector('#radar-chart') as HTMLCanvasElement;
    if (!canvas) return;

    const datasets: any[] = [
      {
        label: 'Combo',
        data: [stats.attack, stats.defense, stats.stamina, stats.burstResistance, stats.weight],
        backgroundColor: 'rgba(249, 115, 22, 0.15)',
        borderColor: '#f97316',
        borderWidth: 2,
        pointBackgroundColor: '#f97316',
        pointBorderColor: '#f97316',
        pointRadius: 3,
        pointHoverRadius: 5,
      },
    ];

    // Add meta average ghost overlay
    if (metaAverage) {
      datasets.push({
        label: 'Meta Average',
        data: [metaAverage.attack, metaAverage.defense, metaAverage.stamina, metaAverage.burstResistance, metaAverage.weight],
        backgroundColor: 'rgba(102, 102, 102, 0.05)',
        borderColor: '#666',
        borderWidth: 1,
        borderDash: [4, 4],
        pointRadius: 0,
        pointHoverRadius: 0,
      });
    }

    activeChart = new Chart(canvas, {
      type: 'radar',
      data: {
        labels: ['ATK', 'DEF', 'STA', 'BURST', 'WGT'],
        datasets,
      },
      options: {
        responsive: false,
        maintainAspectRatio: true,
        scales: {
          r: {
            beginAtZero: true,
            max: 100,
            ticks: {
              stepSize: 25,
              display: false,
              backdropColor: 'transparent',
            },
            grid: {
              color: 'rgba(48, 54, 61, 0.5)',
            },
            angleLines: {
              color: 'rgba(48, 54, 61, 0.5)',
            },
            pointLabels: {
              color: '#a3a3a3',
              font: { family: 'JetBrains Mono, monospace', size: 10 },
            },
          },
        },
        plugins: {
          tooltip: {
            backgroundColor: '#161b22',
            borderColor: '#30363d',
            borderWidth: 1,
            titleFont: { family: 'JetBrains Mono, monospace' },
            bodyFont: { family: 'JetBrains Mono, monospace' },
            callbacks: {
              label: (ctx) => `${ctx.dataset.label}: ${ctx.raw}`,
            },
          },
        },
      },
    });
  }

  function renderTable(combos: ComboStats[]) {
    const tbody = document.getElementById('rankings-body');
    if (!tbody) return;

    if (combos.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="13" class="text-center text-fg-muted py-8">
            No combos found.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = combos.map((combo, index) => {
      const tier = getTier(combo);
      const displayRank = uniqueBladesOnly ? index + 1 : combo.rank;
      const series = getBladeSeries(combo.blade);
      const seriesBadgeClass = series === 'BX' ? 'series-badge-bx' : series === 'UX' ? 'series-badge-ux' : series === 'CX' ? 'series-badge-cx' : '';
      // Extract the base blade name for CX blades (e.g., "Pegasus Blast" -> blade is the full name as stored)
      // For the radar lookup, we need the base blade name from the database
      const bladeBaseName = getBladeBaseName(combo.blade);
      return `
        <tr class="ranking-row hover:bg-panel"
            data-blade="${bladeBaseName}"
            data-ratchet="${combo.ratchet}"
            data-bit="${combo.bit}"
            data-assist="${combo.assist || ''}">
          <td class="font-mono">
            <span class="rank-number text-lg">${displayRank}</span>
          </td>
          <td>
            <span class="${getTierClass(tier)} cursor-pointer hover:ring-2 hover:ring-white/30" data-tier="${tier}">${tier}</span>
          </td>
          <td class="font-mono font-medium text-accent">${combo.blade}</td>
          <td class="font-mono text-series-cx">${combo.assist || '-'}</td>
          <td class="font-mono text-series-ux">${combo.ratchet}</td>
          <td class="font-mono text-series-bx">${combo.bit}</td>
          <td>${series ? `<span class="${seriesBadgeClass}">${series}</span>` : '<span class="text-fg-muted">-</span>'}</td>
          <td class="text-right font-mono text-fg">${combo.raw_score.toFixed(1)}</td>
          <td class="text-right font-mono">${combo.uses}</td>
          <td class="text-right font-mono text-tier-ss">${combo.first}</td>
          <td class="text-right font-mono text-fg-muted">${combo.second}</td>
          <td class="text-right font-mono text-tier-a">${combo.third}</td>
          <td class="text-right">
            ${getTrendHtml(combo.trend)}
          </td>
        </tr>
      `;
    }).join('');

    // Add click handlers to ranking rows (for radar expansion)
    tbody.querySelectorAll('.ranking-row').forEach(row => {
      row.addEventListener('click', (e) => {
        // Don't expand if clicking a tier badge
        const target = e.target as HTMLElement;
        if (target.closest('[data-tier]') && target.closest('[data-tier]') !== row) {
          return;
        }
        toggleComboDetail(row as HTMLTableRowElement);
      });
    });

    // Add click handlers to tier badges
    tbody.querySelectorAll('.tier-badge-ss, .tier-badge-s, .tier-badge-a, .tier-badge-b, .tier-badge-c, .tier-badge-d, .tier-badge-f').forEach(badge => {
      badge.addEventListener('click', (e) => {
        e.stopPropagation();
        const tier = badge.getAttribute('data-tier') || 'all';
        currentTier = tier;
        updateTierStyles(tier);
        applyTierFilter();
      });
    });

    // Animate rows
    staggerFadeIn(tbody.querySelectorAll('tr'), { delay: 20 });
  }

  function getTierClass(tier: string): string {
    const classes: Record<string, string> = {
      SS: 'tier-badge-ss',
      S: 'tier-badge-s',
      A: 'tier-badge-a',
      B: 'tier-badge-b',
      C: 'tier-badge-c',
      D: 'tier-badge-d',
      F: 'tier-badge-f',
    };
    return classes[tier] || 'tier-badge';
  }

  function getTrendHtml(trend: number): string {
    if (trend > 0.1) {
      return `<span class="text-positive text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        +${(trend * 100).toFixed(0)}%
      </span>`;
    } else if (trend < -0.1) {
      return `<span class="text-negative text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        ${(trend * 100).toFixed(0)}%
      </span>`;
    }
    return '<span class="text-fg-muted text-sm">--</span>';
  }

  // Setup load more button
  document.getElementById('load-more-btn')?.addEventListener('click', loadMore);

  // Setup unique blades toggle
  document.getElementById('unique-blades-toggle')?.addEventListener('click', () => {
    uniqueBladesOnly = !uniqueBladesOnly;
    const btn = document.getElementById('unique-blades-toggle');
    if (btn) {
      if (uniqueBladesOnly) {
        btn.classList.remove('text-fg-muted', 'border-fg-muted/30');
        btn.classList.add('bg-accent/10', 'text-accent', 'border-accent/30');
      } else {
        btn.classList.remove('bg-accent/10', 'text-accent', 'border-accent/30');
        btn.classList.add('text-fg-muted', 'border-fg-muted/30');
      }
    }
    applyFilters();
  });

  // Load on DOM ready
  document.addEventListener('DOMContentLoaded', loadRankings);

  // Reload when region changes
  window.addEventListener('regionchange', () => {
    collapseDetail();
    loadRankings();
  });
</script>
