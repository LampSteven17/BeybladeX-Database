---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Assist Rankings">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header */}
    <div class="page-header">
      <h1 class="page-title">Assist Rankings</h1>
      <p class="page-subtitle">
        Secondary blades used in CX combos
      </p>
    </div>

    {/* Rankings Table */}
    <div class="card card-padding">
      <div class="overflow-x-auto">
        <table class="data-table" id="rankings-table">
          <thead>
            <tr>
              <th class="w-16">#</th>
              <th>Assist</th>
              <th class="text-right">APEX</th>
              <th class="text-right">Uses</th>
              <th class="text-right">1st</th>
              <th class="text-right">2nd</th>
              <th class="text-right">3rd</th>
              <th class="text-right">1st %</th>
              <th class="text-right">Trend</th>
            </tr>
          </thead>
          <tbody id="rankings-body">
            {/* Loading skeletons */}
            {Array.from({ length: 10 }, () => (
              <tr>
                <td colspan="9">
                  <div class="skeleton h-12 rounded"></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Info Section */}
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-series-cx">#</span> About Assists
        </h3>
        <p class="text-fg-muted text-sm">
          Assist blades are the 4th component in a Beyblade X combo. They attach to the main blade
          to provide additional weight, balance, or attack/defense capabilities.
        </p>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> Combo Format
        </h3>
        <div class="space-y-2 text-sm">
          <div class="text-fg-muted">
            4-part combo format:
          </div>
          <div class="font-mono text-fg">
            [Blade] + [Assist] [Ratchet][Bit]
          </div>
          <div class="text-fg-muted text-xs mt-2">
            Example: Hells Scythe + Phoenix Wing 3-60F
          </div>
        </div>
      </div>
      <div class="card card-padding">
        <h3 class="text-lg font-mono font-bold text-fg mb-3">
          <span class="text-accent">#</span> APEX Scoring
        </h3>
        <p class="text-fg-muted text-sm">
          APEX score uses recency-weighted placement points: 1st = 3pts, 2nd = 2pts, 3rd = 1pt.
          Recent tournaments count more than older ones.
        </p>
      </div>
    </div>

    {/* Empty State */}
    <div id="empty-state" class="hidden mt-8 card card-padding text-center py-12">
      <div class="text-6xl mb-4">&#x1F50D;</div>
      <h3 class="text-xl font-mono font-bold text-fg mb-2">No Assist Data Found</h3>
      <p class="text-fg-muted">
        Assist blade combinations are not commonly recorded in tournament results yet.
        Check back as more tournaments use the 4-part combo format.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { initDB, getRankedAssists, getBestCombosForAssist, BLADE_SERIES, type Region } from '../lib/db';
  import { staggerFadeIn } from '../lib/animations';

  function getSelectedRegion(): Region {
    if (typeof localStorage !== 'undefined') {
      return (localStorage.getItem('beyblade-region') as Region) || 'ALL';
    }
    return 'ALL';
  }

  async function loadRankings() {
    try {
      await initDB();
      const region = getSelectedRegion();
      const assists = await getRankedAssists(25, 1, region);

      if (assists.length === 0) {
        // Show empty state
        document.getElementById('rankings-table')?.closest('.card')?.classList.add('hidden');
        document.getElementById('empty-state')?.classList.remove('hidden');
        return;
      }

      renderTable(assists);
    } catch (error) {
      console.error('Failed to load rankings:', error);
      const tbody = document.getElementById('rankings-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center text-negative py-8">
              Failed to load assist rankings. Please refresh the page.
            </td>
          </tr>
        `;
      }
    }
  }

  // Get color based on blade series
  function getAssistColor(name: string): { bg: string; text: string; border: string } {
    const series = BLADE_SERIES[name];
    if (series === 'BX') {
      return { bg: 'bg-series-bx/20', text: 'text-series-bx', border: 'border-series-bx/40' };
    } else if (series === 'CX') {
      return { bg: 'bg-series-cx/20', text: 'text-series-cx', border: 'border-series-cx/40' };
    } else if (series === 'UX') {
      return { bg: 'bg-series-ux/20', text: 'text-series-ux', border: 'border-series-ux/40' };
    }
    return { bg: 'bg-accent/20', text: 'text-accent', border: 'border-accent/30' };
  }

  function renderTable(assists: Awaited<ReturnType<typeof getRankedAssists>>) {
    const tbody = document.getElementById('rankings-body');
    if (!tbody) return;

    tbody.innerHTML = assists.map((assist, index) => {
      const color = getAssistColor(assist.name);
      const series = BLADE_SERIES[assist.name];
      return `
      <tr class="ranking-row cursor-pointer hover:bg-panel" data-assist="${assist.name}">
        <td class="font-mono text-center">
          <span class="rank-number text-lg">${index + 1}</span>
        </td>
        <td>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 text-sm font-mono font-bold rounded ${color.bg} ${color.text} border ${color.border}">
              ${assist.name}
            </span>
            ${series ? `<span class="text-xs font-mono text-fg-muted">${series}</span>` : ''}
          </div>
        </td>
        <td class="text-right font-mono text-accent">${assist.raw_score.toFixed(1)}</td>
        <td class="text-right font-mono">${assist.uses}</td>
        <td class="text-right font-mono text-tier-ss">${assist.first}</td>
        <td class="text-right font-mono text-fg-muted">${assist.second}</td>
        <td class="text-right font-mono text-tier-a">${assist.third}</td>
        <td class="text-right font-mono">${assist.uses > 0 ? ((assist.first / assist.uses) * 100).toFixed(1) : '0.0'}%</td>
        <td class="text-right">${getTrendHtml(assist.trend)}</td>
      </tr>
    `}).join('');

    // Add click handlers to rows
    tbody.querySelectorAll('.ranking-row').forEach(row => {
      row.addEventListener('click', () => {
        const assistName = row.getAttribute('data-assist');
        if (assistName) showAssistDetail(assistName, row as HTMLTableRowElement);
      });
    });

    staggerFadeIn(tbody.querySelectorAll('tr'), { delay: 30 });
  }

  // Track expanded detail row state
  let expandedRow: HTMLTableRowElement | null = null;
  let detailRow: HTMLTableRowElement | null = null;

  function collapseDetail() {
    if (expandedRow) {
      expandedRow.classList.remove('expanded');
      expandedRow = null;
    }
    if (detailRow) {
      const oldRow = detailRow;
      detailRow = null;
      const content = oldRow.querySelector('.detail-content');
      if (content) {
        content.classList.remove('open');
        setTimeout(() => oldRow.remove(), 300);
      } else {
        oldRow.remove();
      }
    }
  }

  async function showAssistDetail(name: string, clickedRow?: HTMLTableRowElement) {
    // If clicking the same row, toggle off
    if (clickedRow && expandedRow === clickedRow) {
      collapseDetail();
      return;
    }

    // Collapse any existing detail
    collapseDetail();

    if (!clickedRow) return;

    // Mark this row as expanded
    expandedRow = clickedRow;
    clickedRow.classList.add('expanded');

    // Create the detail row with loading state
    detailRow = document.createElement('tr');
    detailRow.className = 'detail-row';
    detailRow.innerHTML = `
      <td colspan="9">
        <div class="detail-content">
          <div class="detail-inner">
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-lg font-mono font-bold text-fg">${name}</h3>
              <span class="text-fg-muted text-sm">Best combinations</span>
            </div>
            <div id="assist-combos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <div class="col-span-full text-center py-4">
                <div class="w-6 h-6 border-2 border-stroke border-t-accent rounded-full animate-spin mx-auto"></div>
              </div>
            </div>
          </div>
        </div>
      </td>
    `;

    // Insert after the clicked row
    clickedRow.after(detailRow);

    // Trigger open animation
    requestAnimationFrame(() => {
      const content = detailRow?.querySelector('.detail-content');
      if (content) content.classList.add('open');
    });

    try {
      const region = getSelectedRegion();
      const combos = await getBestCombosForAssist(name, 9, region);
      const combosGrid = detailRow?.querySelector('#assist-combos-grid');
      if (!combosGrid) return;

      if (combos.length === 0) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-fg-muted py-4">No combo data available</div>';
        return;
      }

      combosGrid.innerHTML = combos.map((combo, i) => `
        <div class="card card-padding">
          <div class="flex items-start gap-3">
            <span class="rank-number text-lg">${i + 1}</span>
            <div class="flex-grow">
              <div class="font-mono font-bold text-fg text-sm">${combo.combo}</div>
              <div class="flex items-center gap-2 mt-1 text-xs">
                <span class="text-series-ux">${combo.ratchet}</span>
                <span class="text-series-bx">${combo.bit}</span>
              </div>
              <div class="flex items-center gap-3 mt-1 text-xs">
                <span class="text-accent font-mono">${combo.raw_score.toFixed(1)}</span>
                <span class="text-fg-muted">${combo.uses} uses</span>
                <span class="text-tier-ss">${combo.first} wins</span>
              </div>
            </div>
          </div>
        </div>
      `).join('');

      staggerFadeIn(combosGrid.children, { delay: 50 });
    } catch (error) {
      console.error('Failed to load assist combos:', error);
      const combosGrid = detailRow?.querySelector('#assist-combos-grid');
      if (combosGrid) {
        combosGrid.innerHTML = '<div class="col-span-full text-center text-negative py-4">Failed to load combos</div>';
      }
    }
  }

  function getTrendHtml(trend: number): string {
    if (trend > 0.1) {
      return `<span class="text-positive text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        +${(trend * 100).toFixed(0)}%
      </span>`;
    } else if (trend < -0.1) {
      return `<span class="text-negative text-sm inline-flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        ${(trend * 100).toFixed(0)}%
      </span>`;
    }
    return '<span class="text-fg-muted text-sm">--</span>';
  }

  document.addEventListener('DOMContentLoaded', loadRankings);

  // Reload when region changes
  window.addEventListener('regionchange', () => {
    collapseDetail();
    loadRankings();
  });
</script>
