  function renderPartBars(ratchets: any[], bits: any[]) {
    const ratchetContainer = document.getElementById('ratchet-bars');
    const bitContainer = document.getElementById('bit-bars');

    const maxRatchetUses = ratchets[0]?.uses || 1;
    const maxBitUses = bits[0]?.uses || 1;

    if (ratchetContainer) {
      ratchetContainer.innerHTML = ratchets.slice(0, 5).map((r, i) => {
        const percentage = Math.round((r.uses / maxRatchetUses) * 100);
        return `
          <div class="group">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-mono text-fg">${r.name}</span>
              <span class="text-fg-muted tabular-nums">${r.uses}</span>
            </div>
            <div class="micro-bar">
              <div class="micro-bar-fill bg-series-ux" style="width: ${percentage}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    if (bitContainer) {
      bitContainer.innerHTML = bits.slice(0, 5).map((b, i) => {
        const percentage = Math.round((b.uses / maxBitUses) * 100);
        return `
          <div class="group">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-mono text-fg">${b.name}</span>
              <span class="text-fg-muted tabular-nums">${b.uses}</span>
            </div>
            <div class="micro-bar">
              <div class="micro-bar-fill bg-series-bx" style="width: ${percentage}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }
  }

  function renderSeriesBlades(containerId: string, blades: any[], colorClass: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if (!blades || blades.length === 0) {
      container.innerHTML = '<div class="text-fg-muted text-xs text-center py-2">No data</div>';
      return;
    }

    container.innerHTML = blades.map((b, i) => `
      <div class="data-row">
        <span class="data-row-rank text-${colorClass}">${i + 1}</span>
        <span class="data-row-name">${b.blade}</span>
        <span class="data-row-secondary">${b.uses}</span>
        <span class="data-row-value text-${colorClass}">${b.raw_score.toFixed(1)}</span>
      </div>
    `).join('');

    staggerFadeIn(container.children, { delay: 30 });
  }

  function renderMetaLandscape(blades: any[]) {
    const canvas = document.getElementById('meta-landscape-chart') as HTMLCanvasElement;
    if (!canvas) return;

    if (metaLandscapeChart) {
      metaLandscapeChart.destroy();
      metaLandscapeChart = null;
    }

    const topBlades = blades.slice(0, 20);
    const maxScore = Math.max(...topBlades.map(b => b.raw_score));

    // Official packaging colors
    const seriesColors: Record<string, string> = {
      BX: 'rgba(0, 104, 183, 0.7)',    // #0068B7 - Blue
      UX: 'rgba(242, 101, 34, 0.7)',   // #F26522 - Orange
      CX: 'rgba(228, 0, 127, 0.7)',    // #E4007F - Pink
    };

    const bubbleData = topBlades
      .filter(b => BLADE_SERIES[b.blade])
      .map(b => {
        const series = BLADE_SERIES[b.blade];
        const winRate = b.uses > 0 ? (b.first / b.uses) * 100 : 0;
        const normalizedScore = (b.raw_score / maxScore) * 20 + 4;

        return {
          x: b.uses,
          y: winRate,
          r: normalizedScore,
          blade: b.blade,
          series,
          score: b.raw_score,
        };
      });

    const datasets = ['BX', 'UX', 'CX'].map(series => ({
      label: series,
      data: bubbleData.filter(d => d.series === series),
      backgroundColor: seriesColors[series],
      borderColor: seriesColors[series].replace('0.7', '1'),
      borderWidth: 1,
    })).filter(ds => ds.data.length > 0);

    metaLandscapeChart = new Chart(canvas, {
      type: 'bubble',
      data: { datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(22, 27, 34, 0.95)',
            titleColor: '#fbbf24',
            bodyColor: '#f5f5f5',
            borderColor: '#30363d',
            borderWidth: 1,
            padding: 8,
            titleFont: { family: 'monospace', size: 11, weight: 'bold' },
            bodyFont: { family: 'monospace', size: 10 },
            callbacks: {
              title: (items: any) => items[0]?.raw?.blade || '',
              label: (context: any) => {
                const d = context.raw;
                return [`Uses: ${d.x}`, `1st%: ${d.y.toFixed(0)}%`, `Score: ${d.score.toFixed(1)}`];
              },
            },
          },
        },
        scales: {
          x: {
            title: { display: false },
            grid: { color: 'rgba(48, 54, 61, 0.5)' },
            ticks: { color: '#666666', font: { family: 'monospace', size: 9 } },
          },
          y: {
            min: 0,
            max: 100,
            title: { display: false },
            grid: { color: 'rgba(48, 54, 61, 0.5)' },
            ticks: { color: '#666666', font: { family: 'monospace', size: 9 }, callback: (v: any) => `${v}%` },
          },
        },
      },
    });
  }

  async function loadMetaEvolution(region: Region) {
    try {
      const evolution = await getMetaEvolution(region);
      renderMetaEvolution(evolution);
    } catch (error) {
      console.error('Failed to load meta evolution:', error);
      const loadingEl = document.getElementById('meta-evolution-loading');
      if (loadingEl) {
        loadingEl.innerHTML = '<div class="text-fg-muted text-sm text-center py-4">Unable to load meta history</div>';
      }
    }
  }

  function renderMetaEvolution(data: MetaEvolutionData) {
    const loadingEl = document.getElementById('meta-evolution-loading');
    const contentEl = document.getElementById('meta-evolution-content');
    const eraCardsEl = document.getElementById('era-cards');
    const journeyChartEl = document.getElementById('blade-journey-chart');

    if (!data.eras.length) {
      if (loadingEl) loadingEl.innerHTML = '<div class="text-fg-muted text-sm text-center py-4">Not enough data for meta evolution</div>';
      return;
    }

    // Colors for eras and blades - use static classes for Tailwind to detect
    const eraStyles = [
      { border: 'border-series-bx/30', bg: 'bg-series-bx', text: 'text-series-bx' },
      { border: 'border-series-ux/30', bg: 'bg-series-ux', text: 'text-series-ux' },
      { border: 'border-series-cx/30', bg: 'bg-series-cx', text: 'text-series-cx' },
      { border: 'border-tier-ss/30', bg: 'bg-tier-ss', text: 'text-tier-ss' },
    ];
    const bladeColors = ['#22d3ee', '#f87171', '#4ade80', '#fbbf24', '#a78bfa', '#fb923c', '#f472b6', '#2dd4bf', '#e879f9', '#84cc16', '#facc15', '#38bdf8', '#f43f5e', '#34d399', '#c084fc'];

    // Render era cards
    if (eraCardsEl) {
      eraCardsEl.innerHTML = data.eras.map((era, i) => {
        const style = eraStyles[i % eraStyles.length];
        return `
        <div class="terminal-panel p-3 ${style.border}">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-2 h-2 rounded-full ${style.bg}"></div>
            <span class="font-mono text-xs ${style.text} uppercase tracking-wider">${era.name}</span>
          </div>
          <div class="text-[10px] text-fg-muted mb-2">${era.startDate} → ${era.endDate}</div>
          <div class="space-y-1">
            ${era.topBlades.slice(0, 3).map((b, j) => `
              <div class="flex items-center justify-between text-xs">
                <span class="font-mono text-fg truncate">${j + 1}. ${b.blade}</span>
                <span class="text-fg-muted">${b.wins}W</span>
              </div>
            `).join('')}
          </div>
        </div>
      `}).join('');
    }


    // Show content FIRST so we can measure width
    loadingEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    // Render blade journey chart AFTER content is visible (use requestAnimationFrame for layout)
    if (journeyChartEl && data.bladeJourneys.length > 0) {
      requestAnimationFrame(() => {
        const months = data.timeline.map(t => t.month);
        // Now we can accurately measure width since element is visible
        const containerWidth = journeyChartEl.getBoundingClientRect().width;
        const width = Math.max(containerWidth, 400);
        const height = 270;
        const padding = { top: 10, right: 90, bottom: 60, left: 30 };
        const chartWidth = width - padding.left - padding.right;
        const chartHeight = height - padding.top - padding.bottom;

        // Show top 10 blades
        const topJourneys = data.bladeJourneys.slice(0, 15);
        const maxRank = 10; // Show ranks 1-10

        // Create SVG with measured width
        let svg = `<svg width="100%" height="${height}" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" style="display:block;">`;

        // Grid lines for ranks
        for (let rank = 1; rank <= maxRank; rank++) {
          const y = padding.top + ((rank - 1) / (maxRank - 1)) * chartHeight;
          svg += `<line x1="${padding.left}" y1="${y}" x2="${width - padding.right}" y2="${y}" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>`;
          svg += `<text x="${padding.left - 5}" y="${y + 3}" fill="#6b7280" font-size="9" text-anchor="end" font-family="monospace">${rank}</text>`;
        }

        // Month labels - show a tick for every month
        months.forEach((month, i) => {
          const x = padding.left + (i / (months.length - 1)) * chartWidth;
          // Tick mark
          svg += `<line x1="${x}" y1="${padding.top}" x2="${x}" y2="${padding.top + chartHeight}" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>`;
          const label = month.slice(2); // Just "24-01" format
          svg += `<text x="${x}" y="${padding.top + chartHeight + 12}" fill="#6b7280" font-size="8" text-anchor="end" font-family="monospace" transform="rotate(-45, ${x}, ${padding.top + chartHeight + 12})">${label}</text>`;
        });

        // Draw journey lines with fade-in/fade-out for entries and exits
        const lastMonthIdx = months.length - 1;
        topJourneys.forEach((journey, idx) => {
          const color = bladeColors[idx % bladeColors.length];

          // Collect ranked points with their month indices
          type RankedPoint = { mi: number; x: number; y: number };
          const ranked: RankedPoint[] = [];
          journey.monthlyRanks.forEach((mr, i) => {
            if (mr.rank !== null && mr.rank <= maxRank) {
              ranked.push({
                mi: i,
                x: padding.left + (i / (months.length - 1)) * chartWidth,
                y: padding.top + ((mr.rank - 1) / (maxRank - 1)) * chartHeight,
              });
            }
          });
          if (ranked.length < 2) return;

          // Split into consecutive runs (gap = non-consecutive month indices)
          const runs: RankedPoint[][] = [];
          let currentRun: RankedPoint[] = [ranked[0]];
          for (let i = 1; i < ranked.length; i++) {
            if (ranked[i].mi === ranked[i - 1].mi + 1) {
              currentRun.push(ranked[i]);
            } else {
              runs.push(currentRun);
              currentRun = [ranked[i]];
            }
          }
          runs.push(currentRun);

          const firstEverMi = ranked[0].mi;
          const lastEverMi = ranked[ranked.length - 1].mi;
          const isStillActive = lastEverMi === lastMonthIdx;

          // Draw segments for each run
          runs.forEach(run => {
            const isFirstRun = run[0].mi === firstEverMi;
            const isLastRun = run[run.length - 1].mi === lastEverMi;

            for (let i = 0; i < run.length - 1; i++) {
              const segFromStart = i; // 0-based index from run start
              const segFromEnd = (run.length - 1) - i - 1; // 0-based from run end

              let opacity = 0.8;
              let dash = '';

              // Entry fade: first 2 segments of the first run
              if (isFirstRun && segFromStart < 2) {
                opacity = segFromStart === 0 ? 0.15 : 0.4;
              }
              // Exit fade: last 2 segments of the last run (only if blade dropped out)
              if (isLastRun && !isStillActive && segFromEnd < 2) {
                const exitOp = segFromEnd === 0 ? 0.15 : 0.4;
                // If both entry and exit apply (short run), take the lower opacity
                opacity = (isFirstRun && segFromStart < 2) ? Math.min(opacity, exitOp) : exitOp;
                if (segFromEnd === 0) dash = ' stroke-dasharray="4,3"';
              }

              svg += `<line x1="${run[i].x}" y1="${run[i].y}" x2="${run[i + 1].x}" y2="${run[i + 1].y}" stroke="${color}" stroke-width="2" stroke-linecap="round" opacity="${opacity}"${dash}/>`;
            }
          });

          // Collect month indices that belong to runs with 2+ points (have visible segments)
          const connectedMis = new Set<number>();
          runs.forEach(run => { if (run.length >= 2) run.forEach(pt => connectedMis.add(pt.mi)); });

          // Draw dots only for connected points (skip orphan single-month appearances)
          ranked.filter(pt => connectedMis.has(pt.mi)).forEach(pt => {
            if (pt.mi === firstEverMi) {
              // Entry dot: halo ring + solid dot
              svg += `<circle cx="${pt.x}" cy="${pt.y}" r="7" fill="none" stroke="${color}" stroke-width="1" opacity="0.2"/>`;
              svg += `<circle cx="${pt.x}" cy="${pt.y}" r="4" fill="${color}" stroke="#1a1a2e" stroke-width="1"/>`;
            } else if (pt.mi === lastEverMi && !isStillActive) {
              // Exit dot: hollow ring
              svg += `<circle cx="${pt.x}" cy="${pt.y}" r="3.5" fill="#0d1117" stroke="${color}" stroke-width="1.5" opacity="0.5"/>`;
            } else {
              // Normal dot
              svg += `<circle cx="${pt.x}" cy="${pt.y}" r="3" fill="${color}" stroke="#1a1a2e" stroke-width="1"/>`;
            }
          });

          // Inline label at the last connected point
          const connectedPts = ranked.filter(pt => connectedMis.has(pt.mi));
          if (connectedPts.length === 0) return;
          const lastPt = connectedPts[connectedPts.length - 1];
          const labelOpacity = isStillActive ? 0.9 : 0.4;
          const labelName = journey.blade.length > 10 ? journey.blade.slice(0, 9) + '…' : journey.blade;
          svg += `<text x="${lastPt.x + 6}" y="${lastPt.y + 3}" fill="${color}" font-size="8" font-family="'JetBrains Mono', monospace" opacity="${labelOpacity}">${labelName}</text>`;
        });

        svg += '</svg>';
        journeyChartEl.innerHTML = svg;
      });
    }
  }

  function renderTournamentChart(data: { month: string; count: number }[]) {
    const container = document.getElementById('tournament-chart');
    if (!container || data.length === 0) {
      if (container) container.innerHTML = '<div class="text-fg-muted text-sm text-center py-4">No tournament data</div>';
      return;
    }

    const maxCount = Math.max(...data.map(d => d.count));

    // Red-to-green gradient skewed so low counts are very red, high counts very green
    function barColor(count: number): string {
      const t = Math.pow(count / maxCount, 0.6); // skew: most bars lean red unless truly high
      const r = Math.round(220 - 180 * t);
      const g = Math.round(50 + 180 * t);
      const b = Math.round(50 - 20 * t);
      return `rgb(${r}, ${g}, ${b})`;
    }

    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    const barsHtml = data.map(d => {
      const heightPct = Math.max(3, (d.count / maxCount) * 100);
      const [, mm] = d.month.split('-');
      const monthIdx = parseInt(mm, 10) - 1;
      const yr = d.month.slice(2, 4);
      const label = `${months[monthIdx]} '${yr}`;
      const color = barColor(d.count);
      return `
        <div class="flex flex-col items-center" style="flex: 1; min-width: 0;">
          <span class="text-[10px] font-mono text-fg-muted tabular-nums leading-none mb-0.5">${d.count}</span>
          <div class="w-full flex items-end" style="height: 100px;">
            <div class="w-full rounded-t transition-opacity hover:opacity-80" style="height: ${heightPct}%; background: ${color};"></div>
          </div>
          <span class="text-[8px] font-mono text-fg-muted tracking-tight leading-none mt-1">${label}</span>
        </div>
      `;
    }).join('');

    container.style.minHeight = '0';
    container.innerHTML = `<div class="flex items-end gap-0.5">${barsHtml}</div>`;
  }

  document.addEventListener('DOMContentLoaded', loadDashboard);
  window.addEventListener('regionchange', loadDashboard);
</script>
