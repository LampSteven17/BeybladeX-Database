---
import RegionFilter from './RegionFilter.astro';
import TimeFilter from './TimeFilter.astro';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-canvas/95 backdrop-blur-sm border-b border-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 gap-3">
      <!-- Logo -->
      <a href="/combos" class="flex items-center gap-3 group shrink-0">
        <div class="w-8 h-8 bg-pink flex items-center justify-center" style="clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);">
          <span class="text-white font-display text-lg">X</span>
        </div>
        <span class="tracking-tight">
          <span class="font-display text-xl uppercase tracking-wider text-fg">BeybladeX</span>
          <span class="text-fg-muted ml-1 text-[10px] font-mono uppercase tracking-widest hidden sm:inline">Database</span>
        </span>
      </a>

      <!-- Filters (only controls kept) -->
      <div class="flex items-center gap-2 sm:gap-3">
        <TimeFilter />
        <div class="pl-2 sm:pl-3 border-l border-stroke">
          <RegionFilter />
        </div>
      </div>
    </div>
  </div>
</nav>
