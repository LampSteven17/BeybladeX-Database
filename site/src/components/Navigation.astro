---
import RegionFilter from './RegionFilter.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navGroups = [
  {
    label: 'Rankings',
    items: [
      { href: '/combos', label: 'Combos' },
      { href: '/lockchips', label: 'Lock Chips' },
      { href: '/overblades', label: 'Over Blades' },
      { href: '/blades', label: 'Blades' },
      { href: '/assist', label: 'Assists' },
      { href: '/ratchets', label: 'Ratchets' },
      { href: '/bits', label: 'Bits' },
    ],
  },
  {
    label: 'Tools',
    items: [
      { href: '/battles', label: 'Tracker' },
    ],
  },
  {
    label: 'Data Analysis',
    items: [
      { href: '/tools', label: 'Advanced Analysis' },
      { href: '/projections', label: 'Projections' },
      { href: '/methodology', label: 'Methodology' },
      { href: '/admin/new-parts', label: 'Part Approval' },
    ],
  },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

function groupIsActive(items: { href: string }[]): boolean {
  return items.some((item) => isActive(item.href));
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-canvas/95 backdrop-blur-sm border-b border-stroke">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 bg-pink flex items-center justify-center" style="clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);">
          <span class="text-white font-display text-lg">X</span>
        </div>
        <span class="tracking-tight">
          <span class="font-display text-xl uppercase tracking-wider text-fg">BeybladeX</span>
          <span class="text-fg-muted ml-1 text-[10px] font-mono uppercase tracking-widest hidden sm:inline">Database</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navGroups.map((group) => (
          <div class="nav-dropdown relative">
            <button
              class:list={[
                'nav-dropdown-btn flex items-center gap-1 px-3 py-1.5 text-xs font-mono uppercase tracking-wider transition-all duration-150 whitespace-nowrap border-b-2',
                groupIsActive(group.items)
                  ? 'border-pink text-fg bg-panel'
                  : 'border-transparent text-fg-secondary hover:text-fg hover:border-pink/50',
              ]}
            >
              {group.label}
              <svg class="w-3 h-3 nav-chevron transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="nav-dropdown-panel hidden absolute top-full left-0 mt-px min-w-[180px] bg-canvas border border-stroke shadow-lg shadow-black/40">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'block px-4 py-2.5 text-xs font-mono uppercase tracking-wider transition-all duration-150 border-l-2',
                    isActive(item.href)
                      ? 'border-pink text-fg bg-panel'
                      : 'border-transparent text-fg-secondary hover:text-fg hover:border-pink/50 hover:bg-panel',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ))}
        <div class="ml-3 pl-3 border-l border-stroke">
          <RegionFilter />
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-fg-secondary hover:text-pink transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-stroke bg-canvas/95 backdrop-blur-sm">
    <div class="px-4 py-3 space-y-1">
      {navGroups.map((group) => (
        <div class="mobile-nav-group">
          <button
            class:list={[
              'mobile-group-btn flex items-center justify-between w-full px-4 py-2.5 text-sm font-mono uppercase tracking-wider transition-all duration-150 border-l-2',
              groupIsActive(group.items)
                ? 'border-pink text-fg'
                : 'border-transparent text-fg-secondary hover:text-fg hover:border-pink/50',
            ]}
          >
            {group.label}
            <svg class="w-4 h-4 mobile-chevron transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class:list={[
            'mobile-group-panel pl-4 space-y-0.5 overflow-hidden transition-all duration-200',
            groupIsActive(group.items) ? '' : 'hidden',
          ]}>
            {group.items.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block px-4 py-2 text-sm font-mono uppercase tracking-wider transition-all duration-150 border-l-2',
                  isActive(item.href)
                    ? 'border-pink text-fg bg-panel'
                    : 'border-transparent text-fg-secondary hover:text-fg hover:border-pink/50 hover:bg-panel',
                ]}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="pt-3 mt-3 border-t border-stroke">
        <RegionFilter class="justify-center" />
      </div>
    </div>
  </div>
</nav>

<script>
  // Desktop dropdowns
  document.querySelectorAll('.nav-dropdown').forEach((dropdown) => {
    const btn = dropdown.querySelector('.nav-dropdown-btn');
    const panel = dropdown.querySelector('.nav-dropdown-panel');
    const chevron = dropdown.querySelector('.nav-chevron');
    if (!btn || !panel) return;

    btn.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      // Close all other dropdowns first
      document.querySelectorAll('.nav-dropdown-panel').forEach((p) => p.classList.add('hidden'));
      document.querySelectorAll('.nav-chevron').forEach((c) => c.classList.remove('rotate-180'));
      if (!isOpen) {
        panel.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });

  // Close desktop dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!(target as Element).closest?.('.nav-dropdown')) {
      document.querySelectorAll('.nav-dropdown-panel').forEach((p) => p.classList.add('hidden'));
      document.querySelectorAll('.nav-chevron').forEach((c) => c.classList.remove('rotate-180'));
    }
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Mobile group accordions
  document.querySelectorAll('.mobile-group-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.mobile-nav-group');
      const panel = group?.querySelector('.mobile-group-panel');
      const chevron = btn.querySelector('.mobile-chevron');
      if (!panel) return;

      panel.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!menuBtn?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
    }
  });
</script>
